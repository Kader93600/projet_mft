# =====================================================================
# GOTRM Academy — Variables d'environnement
# Copier en .env.local pour le dev, configurer dans Vercel pour la prod.
# Ne JAMAIS committer .env.local ni .env.production.local.
# =====================================================================

# ----- Supabase -----
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # uniquement en backend, jamais exposé client
SUPABASE_PROJECT_ID=xxxxx           # pour `npm run gen:types`

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="GOTRM Academy"

# ----- Email transactionnel (Resend recommandé) -----
# https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM_ADDRESS="GOTRM Academy <noreply@gotrm-academy.fr>"
EMAIL_REPLY_TO=contact@gotrm-academy.fr
# Si tu préfères un autre provider, remplacer par :
#   POSTMARK_SERVER_TOKEN=...
#   SENDGRID_API_KEY=...

# ----- Sentry (monitoring d'erreurs) -----
# https://sentry.io/settings/account/api/auth-tokens/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
SENTRY_ORG=ton-org
SENTRY_PROJECT=gotrm-academy
SENTRY_AUTH_TOKEN=                  # uniquement en CI pour upload des sourcemaps
SENTRY_ENVIRONMENT=production

# ----- Rate limiting (Upstash Redis — optionnel, fallback in-memory) -----
# https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Stripe (paiement direct — étape suivante) -----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- Divers -----
# Active certaines fonctionnalités en cours de finalisation
FEATURE_MFA=false
FEATURE_AI_TUTOR=false
