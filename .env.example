# =====================================================================
# MA FORMATION TRANSPORT — Variables d'environnement
# Copier en .env.local pour le dev, configurer dans Vercel pour la prod.
# Ne JAMAIS committer .env.local ni .env.production.local.
# =====================================================================

# ----- Supabase -----
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # uniquement en backend, jamais exposé client
SUPABASE_PROJECT_ID=xxxxx           # pour `npm run gen:types`

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MA FORMATION TRANSPORT"

# ----- Email transactionnel (Resend recommandé) -----
# https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM_ADDRESS="MA FORMATION TRANSPORT <noreply@maformationtransport.fr>"
EMAIL_REPLY_TO=contact@maformationtransport.fr
# Si tu préfères un autre provider, remplacer par :
#   POSTMARK_SERVER_TOKEN=...
#   SENDGRID_API_KEY=...

# ----- Sentry (monitoring d'erreurs) -----
# https://sentry.io/settings/account/api/auth-tokens/
# NEXT_PUBLIC_SENTRY_DSN = DSN client (erreurs FRONTEND / navigateur). Doit
#   être défini en PROD pour que le monitoring frontend soit actif (sinon le
#   client Sentry est désactivé silencieusement). SENTRY_DSN = fallback serveur.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
SENTRY_DSN=
SENTRY_ORG=ton-org
SENTRY_PROJECT=ma-formation-transport
SENTRY_AUTH_TOKEN=                  # uniquement en CI pour upload des sourcemaps
SENTRY_ENVIRONMENT=production

# ----- Rate limiting (Upstash Redis — optionnel, fallback in-memory) -----
# https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Stripe (paiement direct — étape suivante) -----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- IA tuteur (Sprint 3 P3 #1 — Pédagogie augmentée) -----
# Claude Sonnet 4 pour le chat + la correction QR auto.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx
# OpenAI uniquement pour les embeddings (text-embedding-3-small, 1536 dim).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# ----- Divers -----
# Active certaines fonctionnalités en cours de finalisation
FEATURE_MFA=false
FEATURE_AI_TUTOR=false   # gate côté code : false = endpoint /api/tutor/* renvoie 503

# ----- EDOF (CPF / Caisse des Dépôts) -----
# À renseigner UNIQUEMENT quand la CDC a délivré l'accès API (cf. lib/edof/README.md).
# Tant que ces variables sont absentes, l'intégration reste inerte.
FEATURE_EDOF=false
EDOF_API_BASE_URL=
EDOF_CLIENT_ID=
EDOF_CLIENT_SECRET=
EDOF_OF_SIRET=

# ═════════════════════════════════════════════════════════════════════
# Variables complémentaires (ajoutées 13/07/2026 — sync audit)
# Toutes optionnelles : absentes, la fonctionnalité liée reste inactive.
# ═════════════════════════════════════════════════════════════════════

# ----- Analytics & Ads (tracking marketing) -----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# ----- SEO -----
# Jeton de vérification Google Search Console (balise meta). Voir GSC.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ----- Notifications push (Web Push / VAPID) -----
# Générer une paire de clés VAPID (ex. `npx web-push generate-vapid-keys`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@maformationtransport.fr
PUSH_WEBHOOK_SECRET=

# ----- Crons & secrets serveur -----
# Sans CRON_SECRET, les routes /api/cron/* renvoient 500 (cron_not_configured).
CRON_SECRET=
EMAIL_INBOUND_SECRET=
LEADS_NOTIFY_EMAIL=
