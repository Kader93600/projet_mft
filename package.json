{
  "name": "ma-formation-transport",
  "version": "0.1.0",
  "private": true,
  "description": "MA FORMATION TRANSPORT — Plateforme e-learning multi-formations transport (GOTRM RNCP 40990, Capacité 3,5 t, FIMO/FCO, Taxi/VTC, etc.)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib components",
    "db:seed": "tsx supabase/seed.ts",
    "gen:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > lib/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local --schema public > lib/database.types.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lighthouse": "lhci autorun --config=./.lighthouserc.cjs",
    "a11y": "lhci autorun --config=./.lighthouserc.cjs --collect.settings.onlyCategories=accessibility",
    "a11y:ci": "lhci autorun --config=./.lighthouserc.a11y.cjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/dompurify": "^3.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.451.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "openai": "^6.38.0",
    "pdf-parse": "^1.1.1",
    "posthog-js": "^1.373.5",
    "posthog-node": "^5.34.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@storybook/nextjs": "^10.5.0",
    "@storybook/react": "^10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.47",
    "storybook": "^10.5.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
